# Copy to .env.local and fill in. Real values live in Bitwarden, never here.
# Every variable below must also be set in the Vercel project settings.

# ─── Scheduling (Cal.com) ────────────────────────────────────────────────────
# Settings > Developer > API keys. Used server-side to read, confirm and cancel
# bookings. Never exposed to the browser.
CAL_API_KEY=

# Cal.com account username. Public: forms the booking link for each package,
# e.g. <username>/standard-rate. Safe to expose.
NEXT_PUBLIC_CAL_USERNAME=

# Shared secret for verifying incoming Cal.com webhooks. Set the same value on
# the webhook in Cal.com. Without it the webhook endpoint rejects everything.
CAL_WEBHOOK_SECRET=

# Optional override for where Cal.com sends webhooks. Defaults to
# NEXT_PUBLIC_BASE_URL + /api/webhooks/calcom. Only used by scripts/setup-calcom.ts.
# CAL_WEBHOOK_URL=

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Storage (Upstash Redis / Vercel KV) ─────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
STUDIO_EMAIL=enquires@rtspaces.co.uk
FROM_EMAIL=notifications@rtspaces.co.uk
# Optional: adds newsletter sign-ups to a Resend audience.
# RESEND_AUDIENCE_ID=

# ─── Admin dashboard ─────────────────────────────────────────────────────────
# Password for /admin. Rate limited to 5 attempts per 15 minutes per IP.
ADMIN_PASSWORD=
# Signs admin session cookies. Keep distinct from ADMIN_PASSWORD so changing the
# password does not silently invalidate sessions, and vice versa.
ADMIN_SESSION_SECRET=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Vercel sends this as a bearer token on cron invocations. The expiry sweep that
# releases unpaid holds refuses to run without it.
CRON_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
